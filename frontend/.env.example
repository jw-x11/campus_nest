# Copy to .env.local (ignored by git) and fill in your key.
# Vite reads this file only when it starts or builds, so restart `npm run dev` after editing.
#
# The map uses the first of these that is set with a real key, in this order:
#   1. VITE_MAP_STYLE_URL  2. VITE_MAP_TILE_URL  3. VITE_MAP_FALLBACK_TILE_URL

# 1. Map style for the MapLibre GL map: Geoapify's Klokantech Basic style.
# Get a free key at https://myprojects.geoapify.com and restrict it to your domains.
# Left as YOUR_KEY (or with an empty apiKey), it counts as unset.
VITE_MAP_STYLE_URL=https://maps.geoapify.com/v1/styles/klokantech-basic/style.json?apiKey=YOUR_KEY

# 2. Alternative: a raster tile URL template instead of a style. Used only when VITE_MAP_STYLE_URL is unset.
# Keep {z}/{x}/{y} exactly as written; MapLibre fills them in.
# VITE_MAP_TILE_URL=https://maps.geoapify.com/v1/tile/carto/{z}/{x}/{y}.png?apiKey=YOUR_KEY

# 3. Fallback raster tiles, used when neither of the above has a key. Needs no key.
# The public OpenStreetMap server is for light development use only. When unset, this is the default.
# VITE_MAP_FALLBACK_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Credit shown on the fallback map (HTML allowed). Change it if you change the URL above.
# VITE_MAP_FALLBACK_ATTRIBUTION=© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
