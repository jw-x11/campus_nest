# Backend settings. Copy this file to backend/.env and fill in the values marked YOUR_...
# Lines starting with # are optional: the value shown is the default.

# ---------------------------------------------------------------------------
# PostgreSQL (required)
# ---------------------------------------------------------------------------
# A plain postgresql:// URL is fine; the backend switches it to the asyncpg driver.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/campus_nest

# ---------------------------------------------------------------------------
# Redis (required): listing, search and geocoding caches
# ---------------------------------------------------------------------------
# With a password the format is redis://:PASSWORD@host:port (note the colon before the password).
REDIS_URI=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379

# ---------------------------------------------------------------------------
# SeaweedFS / S3 object storage (required): listing photos and avatars
# ---------------------------------------------------------------------------
# Where the backend uploads to.
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=campus-nest
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY
# The address browsers use to load images. "/media" is proxied to the S3 endpoint by Vite in
# development and by nginx in production. Use a full URL if the bucket is served elsewhere.
S3_PUBLIC_URL=/media
# S3_REGION=us-east-1
# Older name for S3_ENDPOINT, only read when S3_ENDPOINT is empty.
# SEAWEEDFS_S3_ENDPOINT=http://localhost:8333

# ---------------------------------------------------------------------------
# Map: geocoding and address autocomplete (two separate services)
# ---------------------------------------------------------------------------
# Keys are read by the backend only and never sent to the browser.

# Geocoding turns a listing's address into coordinates when the form did not supply them.
# Any Nominatim-compatible service works (the public server allows about 1 request per second).
# GEOCODER_URL=https://nominatim.openstreetmap.org
# Sent as the `key` query parameter to a geocoder other than the public Nominatim server.
# Leave empty for public Nominatim.
# GEOCODER_API_KEY=

# Autocomplete suggests addresses while the user types in the listing form. Public Nominatim
# forbids this, so it uses a separate service. The request format is Geoapify's, so use a
# Geoapify key (free at https://myprojects.geoapify.com) unless you change the code.
# Without a key the address field is a plain text box.
AUTOCOMPLETE_API_KEY=YOUR_GEOAPIFY_API_KEY
# AUTOCOMPLETE_URL=https://api.geoapify.com/v1/geocode/autocomplete

# Identifies this app to the geocoder. Public Nominatim blocks anonymous clients, so put a
# contact address here for production, e.g. CampusNest/1.0 (you@example.com).
# MAP_USER_AGENT=CampusNest/1.0

# Comma-separated country codes that limit where addresses are searched and suggested.
# MAP_COUNTRY_CODES=us

# ---------------------------------------------------------------------------
# Rate limiting (optional)
# ---------------------------------------------------------------------------
# Counters are kept in the Redis above. The limits themselves are in config/rate_limit_config.py.
# RATE_LIMIT_ENABLED=true
# Networks whose X-Real-IP header is trusted as the client address: localhost and the Docker
# bridge nginx connects from. Requests from elsewhere are limited by their own address.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# ---------------------------------------------------------------------------
# Tests only (optional)
# ---------------------------------------------------------------------------
# The test suite empties its database and Redis, so it never uses the ones above. By default it
# runs against the database named like DATABASE_URL plus "_test" (campus_nest_test) and Redis
# database 15 on the same server. Set these to point it somewhere else.
# TEST_DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/campus_nest_test
# TEST_REDIS_URI=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379/15
