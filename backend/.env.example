# Map geocoding (all optional; the defaults use the public Nominatim server).
# Copy the lines you want to change into backend/.env.

# Base URL of the geocoder. Any Nominatim-compatible service works.
# MAP_URL=https://nominatim.openstreetmap.org

# API key, sent as the `key` query parameter. Leave empty for public Nominatim.
# GEOCODER_API_KEY=

# Identifies this app to the geocoder. Public Nominatim blocks anonymous clients,
# so put a contact address here for production, e.g. CampusNest/1.0 (you@example.com).
# MAP_USER_AGENT=CampusNest/1.0

# Comma-separated country codes that limit where addresses are searched.
# MAP_COUNTRY_CODES=us
